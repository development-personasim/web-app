# Supabase Postgres. Server only — do not prefix with NEXT_PUBLIC_.
# Dashboard → Connect → Transaction pooler → URI (port 6543).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Auth — public (safe for browser). Dashboard → Connect / Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://[project-ref].supabase.co/auth/v1/.well-known/jwks.json

# OAuth: enable Google / Facebook / Apple in Dashboard → Authentication → Sign In / Providers.
# Add these redirect URLs in Supabase Auth → URL Configuration:
#   http://localhost:3000/auth/callback
#   https://your-domain.com/auth/callback
# Provider consoles must use the Supabase callback:
#   https://[project-ref].supabase.co/auth/v1/callback
#
# App modals open via query params, e.g.:
#   /en?modal=auth
#   /ru?modal=auth&method=email&view=signup
#
# Locales: en, ru. Translation namespaces live in src/i18n/locales/{lang}/*.json
# and are loaded per page/modal (common+header in layout, home/account/auth on demand).
